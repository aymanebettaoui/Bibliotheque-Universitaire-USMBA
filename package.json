{
  "name": "usmba-library-management",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "db:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema backend/prisma/schema.prisma",
    "db:seed": "tsx --env-file=.env backend/prisma/seed.ts",
    "db:reset": "node scripts/reset-demo-db.mjs",
    "test": "vitest run --config backend/vitest.config.ts",
    "test:e2e": "playwright test",
    "db:test:migrate": "node scripts/migrate-test-db.mjs",
    "provision:staff": "npm run provision:staff -w backend --",
    "test:ocr": "tsx scripts/verify-ocr.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "concurrently": "^9.2.1",
    "prisma": "6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "approve": "^0.0.12",
    "scripts": "^0.1.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "allowScripts": {
    "@prisma/client@6.19.0": true,
    "@prisma/client@7.10.1": true,
    "esbuild@0.28.2": true,
    "sharp@0.35.5": true,
    "tesseract.js@6.0.1": true,
    "prisma@6.19.0": true,
    "@prisma/engines@6.19.0": true
  }
}

# Développement local uniquement. Ne jamais déployer ces valeurs telles quelles.
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://library:library_local_demo@localhost:5432/library?schema=public
TEST_DATABASE_URL=postgresql://library:library_local_demo@localhost:5432/library_test?schema=public
DEMO_MODE=true
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Client OAuth Web Google Identity Services. Identifiant public, aucun secret côté React.
GOOGLE_CLIENT_ID=
# Aucun connecteur officiel fourni : production refuse toute activation par OCR seul.
POSTGRES_USER=library
POSTGRES_PASSWORD=library_local_demo
POSTGRES_DB=library
